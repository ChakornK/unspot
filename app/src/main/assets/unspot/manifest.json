{
  "manifest_version": 3,
  "name": "unspot",
  "version": "1.0",
  "description": "Unspot web extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "@unspot"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.spotify.com/*"],
      "js": ["messagingWrapper.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://open.spotify.com/*"],
      "js": ["renderblock.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.spotify.com/*"],
      "js": ["messaging.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.spotify.com/*"],
      "js": ["adblock.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://*.spotify.com/*",
    "*://*.spotify.net/*",
    "*://*.scdn.co/*",
    "*://*.spotifycdn.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.googletagservices.com/*",
    "*://*.google-analytics.com/*",
    "*://*.moatads.com/*",
    "*://*.pubmatic.com/*",
    "*://*.adnxs.com/*",
    "*://*.scorecardresearch.com/*",
    "*://*.comscore.com/*",
    "*://*.mixpanel.com/*",
    "*://*.intercom.io/*",
    "*://*.adjust.com/*",
    "*://*.crashlytics.com/*",
    "*://*.sentry.io/*",
    "*://*.litix.io/*",
    "*://*.flurry.com/*",
    "*://*.adsafeprotected.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
